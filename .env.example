# ==============================================================================
# Carter's Store Equipment Request Portal - Environment Variables
# ------------------------------------------------------------------------------
# Copy this file to ".env" (local) and/or set these as Environment Variables
# in your Vercel Project Settings. Never commit the real .env file to GitHub.
# ==============================================================================

# ---- Database (REQUIRED) -----------------------------------------------------
# A PostgreSQL connection string. On Vercel use Vercel Postgres, Neon, or
# Supabase. Example format shown below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?connect_timeout=15&sslmode=require"

# ---- Authentication (REQUIRED) ----------------------------------------------
# A long random string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-string"

# The full public URL of the deployed app.
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app  (or your custom domain)
NEXTAUTH_URL="http://localhost:3000"

# ---- Email notifications (OPTIONAL) -----------------------------------------
# The app sends "new request" / "status update" emails via the Abacus.AI email
# API. If you keep this feature, provide the API key and notification IDs.
# If you drop email, you can remove these and the email-sending code.
ABACUSAI_API_KEY="replace-or-remove"
WEB_APP_ID="replace-or-remove"
NOTIF_ID_EQUIPMENT_REQUEST_SUBMITTED="replace-or-remove"
NOTIF_ID_REQUEST_STATUS_UPDATE="replace-or-remove"

# ---- Emergency access (OPTIONAL) --------------------------------------------
# Secret key used by the /emergency-access page/route. Generate a random value.
EMERGENCY_ACCESS_KEY="replace-with-a-strong-random-string"
